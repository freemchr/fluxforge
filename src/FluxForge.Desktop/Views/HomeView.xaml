<UserControl x:Class="FluxForge.Desktop.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:FluxForge.Desktop.ViewModels"
             xmlns:v="clr-namespace:FluxForge.Desktop.Views"
             xmlns:jobs="clr-namespace:FluxForge.Application.Jobs;assembly=FluxForge.Application"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:HomeViewModel}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20,14,20,20" MaxWidth="1100" HorizontalAlignment="Center">
            <Image Source="{StaticResource FfLogo}" Height="120" HorizontalAlignment="Center" Margin="0,4,0,18"
                   RenderOptions.BitmapScalingMode="HighQuality" AutomationProperties.Name="FluxForge — Preserve the past one disk at a time" />

            <!-- First-run: host tools missing -->
            <Border Style="{StaticResource FfCard}" BorderBrush="{StaticResource FfAccentBrush}"
                    Visibility="{Binding State.ToolsReady, Converter={StaticResource VisibleWhen}, ConverterParameter=invert}">
                <StackPanel>
                    <TextBlock Text="Set up the Greaseweazle host tools" Style="{StaticResource FfSectionHeader}" />
                    <TextBlock Text="{Binding State.ToolsStatus.Message}" Style="{StaticResource FfBody}" Margin="0,0,0,12" />
                    <v:ToolsSetupView DataContext="{Binding Setup}" />
                </StackPanel>
            </Border>

            <!-- Update available: always ask, never install silently -->
            <Border Style="{StaticResource FfCard}" BorderBrush="{StaticResource FfInfoBrush}"
                    Visibility="{Binding State.ShowUpdatePrompt, Converter={StaticResource VisibleWhen}}">
                <DockPanel>
                    <ui:SymbolIcon DockPanel.Dock="Left" Symbol="ArrowCircleUp24" FontSize="28" Foreground="{StaticResource FfInfoBrush}" Margin="0,0,12,0" VerticalAlignment="Top" />
                    <StackPanel>
                        <TextBlock Style="{StaticResource FfSectionHeader}" Margin="0,0,0,2"
                                   Text="{Binding State.LatestRelease.Version, StringFormat='Greaseweazle host tools {0} is available'}" />
                        <TextBlock Text="{Binding State.VersionSummary}" Style="{StaticResource FfSubtitle}" />
                        <TextBlock Style="{StaticResource FfSubtitle}" FontSize="11" Margin="0,2,0,8"
                                   Text="Your current version stays installed. If you need a particular version, you can switch or install older ones in Settings." />
                        <WrapPanel>
                            <ui:Button Appearance="Primary" Content="Review update…" Command="{Binding ReviewUpdateCommand}" Margin="0,0,8,0" />
                            <ui:Button Content="Not now" Command="{Binding DismissUpdateCommand}" Margin="0,0,8,0" />
                            <ui:Button Appearance="Transparent" Content="Skip this version" Command="{Binding SkipUpdateCommand}" Margin="0,0,8,0" />
                            <ui:Button Appearance="Transparent" Content="Manage versions" Command="{Binding GoCommand}" CommandParameter="settings" />
                        </WrapPanel>
                    </StackPanel>
                </DockPanel>
            </Border>

            <UniformGrid Columns="2">
                <Border Style="{StaticResource FfCard}" Margin="0,0,6,12">
                    <StackPanel>
                        <TextBlock Text="Host tools" Style="{StaticResource FfLabel}" Margin="0,0,0,4" />
                        <TextBlock FontSize="16" FontWeight="SemiBold">
                            <Run Text="{Binding State.ToolsStatus.State, Converter={StaticResource Status}, ConverterParameter=glyph, Mode=OneWay}"
                                 Foreground="{Binding State.ToolsStatus.State, Converter={StaticResource Status}, ConverterParameter=brush, Mode=OneWay}" />
                            <Run Text="{Binding State.ToolsStatus.State, Converter={StaticResource Status}, Mode=OneWay}" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        </TextBlock>
                        <TextBlock Text="{Binding State.ToolsStatus.Message}" Style="{StaticResource FfSubtitle}" Margin="0,4,0,0" />
                        <TextBlock Text="{Binding State.Tools.ExecutablePath}" Style="{StaticResource FfSubtitle}" FontSize="11" Margin="0,4,0,0"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                        <TextBlock Text="{Binding State.VersionSummary}" Style="{StaticResource FfSubtitle}" FontSize="12" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource FfCard}" Margin="6,0,0,12">
                    <DockPanel>
                        <ui:Button DockPanel.Dock="Right" VerticalAlignment="Top" Content="Detect" Icon="{ui:SymbolIcon ArrowSync24}"
                                   Command="{Binding DetectDeviceCommand}" IsEnabled="{Binding State.ToolsReady}" />
                        <StackPanel>
                            <TextBlock Text="Greaseweazle device" Style="{StaticResource FfLabel}" Margin="0,0,0,4" />
                            <TextBlock FontSize="16" FontWeight="SemiBold">
                                <Run Text="{Binding State.Device.State, Converter={StaticResource Status}, ConverterParameter=glyph, Mode=OneWay}"
                                     Foreground="{Binding State.Device.State, Converter={StaticResource Status}, ConverterParameter=brush, Mode=OneWay}" />
                                <Run Text="{Binding State.Device.State, Converter={StaticResource Status}, Mode=OneWay}" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            </TextBlock>
                            <TextBlock Text="{Binding State.Device.Message}" Style="{StaticResource FfSubtitle}" Margin="0,4,0,0" />
                            <ui:ProgressRing IsIndeterminate="True" Width="18" Height="18" HorizontalAlignment="Left" Margin="0,6,0,0"
                                             Visibility="{Binding State.IsDetecting, Converter={StaticResource VisibleWhen}}" />
                        </StackPanel>
                    </DockPanel>
                </Border>
            </UniformGrid>

            <TextBlock Text="Quick actions" Style="{StaticResource FfSectionHeader}" Margin="0,8,0,10" />
            <UniformGrid Columns="4" Margin="0,0,0,16">
                <ui:Button Appearance="Primary" Height="48" HorizontalAlignment="Stretch" Margin="0,0,8,0" Icon="{ui:SymbolIcon ArrowDownload24}"
                           Content="Back Up Disk" Command="{Binding GoCommand}" CommandParameter="read" />
                <ui:Button Height="48" HorizontalAlignment="Stretch" Margin="0,0,8,0" Icon="{ui:SymbolIcon ArrowUpload24}"
                           Content="Write Image" Command="{Binding GoCommand}" CommandParameter="write" />
                <ui:Button Height="48" HorizontalAlignment="Stretch" Margin="0,0,8,0" Icon="{ui:SymbolIcon Image24}"
                           Content="Open Image" Command="{Binding GoCommand}" CommandParameter="studio" />
                <ui:Button Height="48" HorizontalAlignment="Stretch" Icon="{ui:SymbolIcon ArrowSwap24}"
                           Content="Convert Image" Command="{Binding GoCommand}" CommandParameter="studio" />
            </UniformGrid>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource FfCard}" Margin="0,0,6,0">
                    <StackPanel>
                        <DockPanel>
                            <ui:Button DockPanel.Dock="Right" Appearance="Transparent" Content="View all" Command="{Binding GoCommand}" CommandParameter="activity" />
                            <TextBlock Text="Recent activity" Style="{StaticResource FfSectionHeader}" />
                        </DockPanel>
                        <TextBlock Text="No jobs yet. Your reads and writes will appear here with their outcome."
                                   Style="{StaticResource FfSubtitle}"
                                   Visibility="{Binding RecentJobs.Count, Converter={StaticResource VisibleWhen}, ConverterParameter=invert}" />
                        <ItemsControl ItemsSource="{Binding RecentJobs}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type jobs:JobRecord}">
                                    <Grid Margin="0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="24" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock FontWeight="Bold" Text="{Binding Status, Converter={StaticResource Status}, ConverterParameter=glyph}"
                                                   Foreground="{Binding Status, Converter={StaticResource Status}, ConverterParameter=brush}" />
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding Title}" Style="{StaticResource FfBody}" />
                                            <TextBlock Text="{Binding StatusDetail}" Style="{StaticResource FfSubtitle}" FontSize="12" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Margin="12,0,0,0">
                                            <TextBlock Text="{Binding Status, Converter={StaticResource Status}}" HorizontalAlignment="Right"
                                                       Foreground="{Binding Status, Converter={StaticResource Status}, ConverterParameter=brush}" FontSize="12" />
                                            <TextBlock Text="{Binding StartedAt, Converter={StaticResource LocalTime}, StringFormat='{}{0:d MMM HH:mm}'}" HorizontalAlignment="Right"
                                                       Style="{StaticResource FfSubtitle}" FontSize="11" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource FfCard}" Margin="6,0,0,0">
                    <StackPanel>
                        <TextBlock Text="Getting started" Style="{StaticResource FfSectionHeader}" />
                        <ItemsControl ItemsSource="{Binding Checklist}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:ChecklistItem}">
                                    <TextBlock Style="{StaticResource FfBody}" Margin="0,4">
                                        <Run Text="{Binding Glyph, Mode=OneWay}" FontWeight="Bold" Foreground="{StaticResource FfAccentBrush}" />
                                        <Run Text="{Binding Text, Mode=OneWay}" />
                                    </TextBlock>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Style="{StaticResource FfSubtitle}" FontSize="12" Margin="0,12,0,0"
                                   Text="Tip: slide the disk's write-protect tab to protected before reading an original." />
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
