<UserControl x:Class="FluxForge.Desktop.Views.ImageStudioView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:FluxForge.Desktop.ViewModels"
             xmlns:v="clr-namespace:FluxForge.Desktop.Views"
             xmlns:jobs="clr-namespace:FluxForge.Application.Jobs;assembly=FluxForge.Application"
             xmlns:safety="clr-namespace:FluxForge.Application.Safety;assembly=FluxForge.Application"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:ImageStudioViewModel}">
    <Grid Margin="16,12,16,0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="380" />
            <ColumnDefinition Width="14" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,18,24" IsEnabled="{Binding IsRunning, Converter={StaticResource Not}}">
                <TextBlock Text="Image Studio" Style="{StaticResource FfPageTitle}" />
                <TextBlock Style="{StaticResource FfSubtitle}" Margin="0,0,0,10"
                           Text="Decode a saved raw flux capture into a disk image, with any format, without touching the disk again." />

                <Border Style="{StaticResource FfCard}">
                    <StackPanel>
                        <TextBlock Text="1 · Raw capture" Style="{StaticResource FfSectionHeader}" />
                        <DockPanel>
                            <ui:Button DockPanel.Dock="Right" Content="Browse…" Command="{Binding BrowseInputCommand}" Margin="8,0,0,0" />
                            <ui:TextBox Text="{Binding InputPath, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Browse, or paste the path to a .scp file"
                                        AutomationProperties.Name="Raw capture file" />
                        </DockPanel>
                        <TextBlock Text="{Binding InputSummary}" Style="{StaticResource FfSubtitle}" Margin="0,6,0,0" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource FfCard}">
                    <StackPanel>
                        <TextBlock Text="2 · Decode as" Style="{StaticResource FfSectionHeader}" />
                        <ComboBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}" AutomationProperties.Name="Disk format">
                            <ComboBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:ProfileOption}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}" />
                                        <TextBlock Text="{Binding Detail}" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <TextBlock Style="{StaticResource FfSubtitle}" FontSize="12" Margin="0,8,0,0"
                                   Text="Not sure? Decode once — if the disk has sectors this format doesn't cover, FluxForge will say so and suggest a better match." />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource FfCard}">
                    <StackPanel>
                        <TextBlock Text="3 · Output" Style="{StaticResource FfSectionHeader}" />
                        <TextBlock Text="File name (saved next to the capture)" Style="{StaticResource FfLabel}" Margin="0,0,0,4" />
                        <TextBox Text="{Binding OutputFileName, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Output file name" />
                        <TextBlock Style="{StaticResource FfSubtitle}" FontSize="12" Margin="0,8,0,0"
                                   Text="The raw capture is only read. Existing files are never overwritten." />
                    </StackPanel>
                </Border>

                <ItemsControl ItemsSource="{Binding Issues}" Focusable="False" Margin="0,0,0,8">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type safety:SafetyIssue}">
                            <TextBlock Style="{StaticResource FfBody}" FontSize="12" Margin="0,2">
                                <Run Text="⚠ " Foreground="{StaticResource FfWarningBrush}" /><Run Text="{Binding Message, Mode=OneWay}" />
                            </TextBlock>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="Command preview" Style="{StaticResource FfLabel}" />
                <TextBox Text="{Binding CommandPreview, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap"
                         FontFamily="{StaticResource FfMonoFont}" FontSize="12" AutomationProperties.Name="Command preview" />
            </StackPanel>
        </ScrollViewer>

        <DockPanel Grid.Column="2">
            <Border DockPanel.Dock="Top" Style="{StaticResource FfCard}" Margin="0,0,18,8">
                <StackPanel>
                    <WrapPanel>
                        <ui:Button Appearance="Primary" Content="Decode" Icon="{ui:SymbolIcon ArrowSwap24}" Height="34" MinWidth="140"
                                   Command="{Binding DecodeCommand}" Margin="0,0,8,0" />
                        <ui:Button Content="Cancel" Icon="{ui:SymbolIcon Stop24}" Height="34" Command="{Binding CancelCommand}" />
                    </WrapPanel>
                    <TextBlock Text="{Binding BlockedReason}" Style="{StaticResource FfSubtitle}" Margin="0,8,0,0"
                               Visibility="{Binding BlockedReason, Converter={StaticResource VisibleWhen}}" />
                </StackPanel>
            </Border>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,0,18,24">
                    <Border Style="{StaticResource FfCard}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock FontSize="17" FontWeight="SemiBold" AutomationProperties.LiveSetting="Polite">
                                    <Run Text="{Binding Console.Status, Converter={StaticResource Status}, ConverterParameter=glyph, Mode=OneWay}"
                                         Foreground="{Binding Console.Status, Converter={StaticResource Status}, ConverterParameter=brush, Mode=OneWay}" />
                                    <Run Text="{Binding Console.Status, Converter={StaticResource Status}, Mode=OneWay}" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                </TextBlock>
                                <TextBlock Text="{Binding Console.CurrentTrack}" Style="{StaticResource FfSubtitle}" />
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="{Binding Console.Elapsed}" FontSize="17" FontFamily="{StaticResource FfMonoFont}"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource FfCard}" Visibility="{Binding LastResult, Converter={StaticResource VisibleWhen}}"
                            BorderBrush="{Binding LastResult.Status, Converter={StaticResource Status}, ConverterParameter=brush}">
                        <StackPanel>
                            <TextBlock Text="Summary" Style="{StaticResource FfSectionHeader}" />
                            <TextBlock Text="{Binding LastResult.StatusDetail}" Style="{StaticResource FfBody}" Margin="0,0,0,8" />
                            <!-- One-click retry with the format the disk actually uses -->
                            <Border Visibility="{Binding Suggestion, Converter={StaticResource VisibleWhen}}" Padding="10" Margin="0,0,0,8" CornerRadius="6"
                                    BorderThickness="1" BorderBrush="{StaticResource FfAccentBrush}" Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}">
                                <DockPanel>
                                    <ui:Button DockPanel.Dock="Right" Appearance="Primary" Icon="{ui:SymbolIcon ArrowRepeatAll24}"
                                               Content="{Binding Suggestion.Title}" ContentStringFormat="Decode as {0}" Command="{Binding DecodeWithSuggestionCommand}" />
                                    <TextBlock Style="{StaticResource FfBody}" VerticalAlignment="Center" Margin="0,0,12,0"
                                               Text="This capture fits another format better. Decode it again — the disk isn't needed." />
                                </DockPanel>
                            </Border>
                            <ItemsControl ItemsSource="{Binding LastResult.Artifacts}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type jobs:JobArtifact}">
                                        <StackPanel Margin="0,4">
                                            <TextBlock Style="{StaticResource FfBody}" FontSize="12">
                                                <Run Text="{Binding Kind, Mode=OneWay}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                <Run Text="{Binding Path, Mode=OneWay}" />
                                            </TextBlock>
                                            <TextBox IsReadOnly="True" FontFamily="{StaticResource FfMonoFont}" FontSize="11" Margin="0,2,0,0"
                                                     Text="{Binding Sha256, StringFormat='SHA-256 {0}', Mode=OneWay}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <ui:Button Content="Show in folder" Icon="{ui:SymbolIcon FolderOpen24}" Command="{Binding ShowResultCommand}" Visibility="{Binding LastResult.Artifacts, Converter={StaticResource VisibleWhen}}" Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource FfCard}">
                        <StackPanel>
                            <TextBlock Text="Track map" Style="{StaticResource FfSectionHeader}" />
                            <v:TrackMapView DataContext="{Binding TrackMap}" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource FfCard}">
                        <StackPanel>
                            <TextBlock Text="Console output (exact gw output, also saved to the job log)" Style="{StaticResource FfSectionHeader}" />
                            <TextBox Style="{StaticResource FfLogBox}" Height="180" Text="{Binding Console.LogText, Mode=OneWay}"
                                     AutomationProperties.Name="Console output" TextChanged="ScrollToEnd" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Grid>
</UserControl>
