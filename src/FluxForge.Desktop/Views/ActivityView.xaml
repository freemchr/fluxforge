<UserControl x:Class="FluxForge.Desktop.Views.ActivityView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:FluxForge.Desktop.ViewModels"
             xmlns:v="clr-namespace:FluxForge.Desktop.Views"
             xmlns:jobs="clr-namespace:FluxForge.Application.Jobs;assembly=FluxForge.Application"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:ActivityViewModel}">
    <Grid Margin="16,12,16,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="340" />
            <ColumnDefinition Width="14" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.ColumnSpan="3" Margin="0,0,0,12">
            <TextBlock Text="Activity" Style="{StaticResource FfPageTitle}" />
            <TextBlock Text="Every read and write is recorded with its exact command, tool version, output and file hashes." Style="{StaticResource FfSubtitle}" />
        </StackPanel>

        <DockPanel Grid.Row="1">
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                <ui:Button DockPanel.Dock="Right" Icon="{ui:SymbolIcon ArrowSync24}" Command="{Binding LoadCommand}" Margin="8,0,0,0"
                           ToolTip="Refresh" AutomationProperties.Name="Refresh" />
                <ui:TextBox PlaceholderText="Search title, label, format or status" Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged}"
                            AutomationProperties.Name="Search jobs" />
            </DockPanel>
            <ListBox ItemsSource="{Binding Jobs}" SelectedItem="{Binding Selected}" AutomationProperties.Name="Job history">
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type jobs:JobRecord}">
                        <Grid Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="22" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock FontWeight="Bold" Text="{Binding Status, Converter={StaticResource Status}, ConverterParameter=glyph}"
                                       Foreground="{Binding Status, Converter={StaticResource Status}, ConverterParameter=brush}" />
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                <TextBlock FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                                    <Run Text="{Binding Status, Converter={StaticResource Status}, Mode=OneWay}" />
                                    <Run Text="·" />
                                    <Run Text="{Binding StartedAt, StringFormat='{}{0:d MMM yyyy HH:mm}', Mode=OneWay}" />
                                </TextBlock>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <ScrollViewer Grid.Row="1" Grid.Column="2" VerticalScrollBarVisibility="Auto">
            <StackPanel Visibility="{Binding Selected, Converter={StaticResource VisibleWhen}}">
                <WrapPanel Margin="0,0,0,12">
                    <ui:Button Content="Open job folder" Icon="{ui:SymbolIcon FolderOpen24}" Command="{Binding OpenFolderCommand}" Margin="0,0,8,0" />
                    <ui:Button Content="Export report…" Icon="{ui:SymbolIcon Share24}" Command="{Binding ExportReportCommand}" Margin="0,0,12,0" />
                    <CheckBox IsChecked="{Binding RedactPaths}" Content="Redact folder paths" VerticalAlignment="Center" />
                </WrapPanel>
                <Border Style="{StaticResource FfCard}">
                    <TextBox Style="{StaticResource FfLogBox}" Text="{Binding ReportText, Mode=OneWay}" MaxHeight="420" BorderThickness="0"
                             AutomationProperties.Name="Job report" />
                </Border>
                <Border Style="{StaticResource FfCard}">
                    <StackPanel>
                        <TextBlock Text="Track map" Style="{StaticResource FfSectionHeader}" />
                        <v:TrackMapView DataContext="{Binding TrackMap}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
