<UserControl x:Class="FluxForge.Desktop.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:FluxForge.Desktop.ViewModels"
             xmlns:v="clr-namespace:FluxForge.Desktop.Views"
             xmlns:tools="clr-namespace:FluxForge.Application.Tools;assembly=FluxForge.Application"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:SettingsViewModel}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20,14,20,20" MaxWidth="860" HorizontalAlignment="Left">
            <TextBlock Text="Settings" Style="{StaticResource FfPageTitle}" Margin="0,0,0,10" />

            <Border Style="{StaticResource FfCard}">
                <StackPanel>
                    <TextBlock Text="Greaseweazle host tools" Style="{StaticResource FfSectionHeader}" />
                    <TextBlock Style="{StaticResource FfBody}">
                        <Run Text="{Binding State.ToolsStatus.State, Converter={StaticResource Status}, ConverterParameter=glyph, Mode=OneWay}"
                             Foreground="{Binding State.ToolsStatus.State, Converter={StaticResource Status}, ConverterParameter=brush, Mode=OneWay}" FontWeight="Bold" />
                        <Run Text="{Binding State.ToolsStatus.Message, Mode=OneWay}" />
                    </TextBlock>
                    <TextBlock Text="{Binding State.Tools.ExecutablePath}" Style="{StaticResource FfSubtitle}" FontSize="11" Margin="0,2,0,0" />
                    <TextBlock Text="{Binding State.VersionSummary}" Style="{StaticResource FfBody}" FontWeight="SemiBold" Margin="0,8,0,0" />
                    <TextBlock Text="{Binding State.UpdateCheckMessage}" Style="{StaticResource FfSubtitle}"
                               Visibility="{Binding State.UpdateCheckMessage, Converter={StaticResource VisibleWhen}}" />

                    <WrapPanel Margin="0,8,0,0">
                        <ui:Button Content="Check now" Icon="{ui:SymbolIcon ArrowSync24}" Command="{Binding CheckNowCommand}" Margin="0,0,8,6" />
                        <ui:Button Content="Re-detect tools and device" Command="{Binding RefreshCommand}" Margin="0,0,8,6" />
                    </WrapPanel>
                    <CheckBox IsChecked="{Binding CheckForUpdates}" Content="Check for new releases once a day and ask before updating" />
                    <TextBlock Style="{StaticResource FfSubtitle}" FontSize="11" Margin="28,0,0,0"
                               Text="Turn this off if you need to stay on a particular version. FluxForge never updates without asking." />
                    <DockPanel Margin="0,6,0,0" Visibility="{Binding SkippedVersion, Converter={StaticResource VisibleWhen}}">
                        <ui:Button DockPanel.Dock="Right" Appearance="Transparent" Content="Remind me again" Command="{Binding ClearSkippedVersionCommand}" />
                        <TextBlock Text="{Binding SkippedVersion, StringFormat='You skipped version {0}.'}" Style="{StaticResource FfSubtitle}" VerticalAlignment="Center" />
                    </DockPanel>

                    <v:ToolsSetupView DataContext="{Binding Setup}" Margin="0,10,0,0" />

                    <!-- Installed versions: switch freely, including back to older ones -->
                    <TextBlock Text="Installed versions" Style="{StaticResource FfSectionHeader}" Margin="0,16,0,4" />
                    <TextBlock Text="None installed by FluxForge yet." Style="{StaticResource FfSubtitle}"
                               Visibility="{Binding ManagedVersions.Count, Converter={StaticResource VisibleWhen}, ConverterParameter=invert}" />
                    <ItemsControl ItemsSource="{Binding ManagedVersions}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type tools:ManagedVersion}">
                                <Border Padding="8,6" Margin="0,2" CornerRadius="4" Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}">
                                    <DockPanel>
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                            <ui:Button Content="Use this version" Margin="6,0,0,0"
                                                       Command="{Binding DataContext.UseVersionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                                       Visibility="{Binding IsActive, Converter={StaticResource VisibleWhen}, ConverterParameter=invert}" />
                                            <ui:Button Content="Remove" Appearance="Transparent" Margin="6,0,0,0"
                                                       Command="{Binding DataContext.RemoveVersionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                                       Visibility="{Binding IsActive, Converter={StaticResource VisibleWhen}, ConverterParameter=invert}" />
                                        </StackPanel>
                                        <TextBlock VerticalAlignment="Center" Style="{StaticResource FfBody}">
                                            <Run Text="{Binding Version, Mode=OneWay}" FontWeight="SemiBold" />
                                            <Run Text="  ● in use" Foreground="{StaticResource FfSuccessBrush}">
                                                <Run.Style>
                                                    <Style TargetType="Run">
                                                        <Setter Property="Text" Value="" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsActive}" Value="True"><Setter Property="Text" Value="  ● in use" /></DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Run.Style>
                                            </Run>
                                        </TextBlock>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="{Binding VersionError}" Foreground="{StaticResource FfErrorBrush}" TextWrapping="Wrap"
                               Visibility="{Binding VersionError, Converter={StaticResource VisibleWhen}}" />

                    <!-- Every stable release, so users can install an older one they depend on -->
                    <DockPanel Margin="0,16,0,4">
                        <ui:Button DockPanel.Dock="Right" Content="Show available versions" Icon="{ui:SymbolIcon CloudArrowDown24}"
                                   Command="{Binding LoadReleasesCommand}" />
                        <TextBlock Text="Available versions" Style="{StaticResource FfSectionHeader}" VerticalAlignment="Center" Margin="0" />
                    </DockPanel>
                    <TextBlock Style="{StaticResource FfSubtitle}" FontSize="11"
                               Text="Stable releases from github.com/keirf/greaseweazle. Installing an older version keeps your current one so you can switch back." />
                    <ui:ProgressRing IsIndeterminate="True" Width="18" Height="18" HorizontalAlignment="Left" Margin="0,6,0,0"
                                     Visibility="{Binding IsLoadingReleases, Converter={StaticResource VisibleWhen}}" />
                    <TextBlock Text="{Binding ReleasesError}" Foreground="{StaticResource FfErrorBrush}" TextWrapping="Wrap"
                               Visibility="{Binding ReleasesError, Converter={StaticResource VisibleWhen}}" />
                    <ItemsControl ItemsSource="{Binding Releases}" Focusable="False" Margin="0,6,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:ReleaseRow}">
                                <Border Padding="8,4" Margin="0,1" CornerRadius="4" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                                    <DockPanel>
                                        <ui:Button DockPanel.Dock="Right" Content="Install…"
                                                   Command="{Binding DataContext.InstallReleaseCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                                   Visibility="{Binding CanInstall, Converter={StaticResource VisibleWhen}}" />
                                        <TextBlock VerticalAlignment="Center" Style="{StaticResource FfBody}">
                                            <Run Text="{Binding Version, Mode=OneWay}" FontWeight="SemiBold" />
                                            <Run Text="{Binding Published, Mode=OneWay}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" />
                                            <Run Text="{Binding Tags, Mode=OneWay}" Foreground="{StaticResource FfAccentBrush}" FontSize="12" />
                                        </TextBlock>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <StackPanel Visibility="{Binding CustomGwPath, Converter={StaticResource VisibleWhen}}" Margin="0,12,0,0">
                        <TextBlock Text="Your own installation (FluxForge never modifies it)" Style="{StaticResource FfLabel}" />
                        <DockPanel>
                            <ui:Button DockPanel.Dock="Right" Content="Stop using" Command="{Binding ClearCustomPathCommand}" Margin="8,0,0,0" />
                            <TextBox Text="{Binding CustomGwPath, Mode=OneWay}" IsReadOnly="True" />
                        </DockPanel>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource FfCard}">
                <StackPanel>
                    <TextBlock Text="Device" Style="{StaticResource FfSectionHeader}" />
                    <TextBlock Text="COM port (leave empty to let gw find the board)" Style="{StaticResource FfLabel}" Margin="0,0,0,4" />
                    <DockPanel>
                        <ui:Button DockPanel.Dock="Right" Content="Save and detect" Command="{Binding SaveDevicePortCommand}" Margin="8,0,0,0" />
                        <TextBox Text="{Binding DevicePort, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="COM port" />
                    </DockPanel>
                    <TextBlock Style="{StaticResource FfSubtitle}" FontSize="12" Margin="0,8,0,0"
                               Text="On Windows 10 and 11 the Greaseweazle normally appears as a USB serial (COM) device with the built-in driver. FluxForge never installs drivers. Firmware updates will be offered only through the Drive Tools firmware assistant, always with explicit confirmation." />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource FfCard}">
                <StackPanel>
                    <TextBlock Text="Appearance" Style="{StaticResource FfSectionHeader}" />
                    <CheckBox IsChecked="{Binding IsDarkTheme}" Content="Dark theme" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource FfCard}">
                <StackPanel>
                    <TextBlock Text="Data and privacy" Style="{StaticResource FfSectionHeader}" />
                    <TextBlock Style="{StaticResource FfBody}" Margin="0,0,0,8"
                               Text="Everything stays on this PC. The only network traffic is the daily host-tools release check and downloads you approve." />
                    <DockPanel>
                        <ui:Button DockPanel.Dock="Right" Content="Open" Command="{Binding OpenDataFolderCommand}" Margin="8,0,0,0" />
                        <TextBox Text="{Binding DataFolder, Mode=OneWay}" IsReadOnly="True" />
                    </DockPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource FfCard}">
                <StackPanel>
                    <TextBlock Text="About" Style="{StaticResource FfSectionHeader}" />
                    <TextBlock Style="{StaticResource FfBody}" Text="{Binding AppVersion, StringFormat='FluxForge {0} — preview build'}" />
                    <TextBlock Style="{StaticResource FfSubtitle}" Margin="0,4,0,8"
                               Text="FluxForge is an independent frontend and is not an official Greaseweazle product. Greaseweazle is created by Keir Fraser." />
                    <WrapPanel>
                        <ui:Button Appearance="Transparent" Content="Greaseweazle on GitHub" Command="{Binding OpenLinkCommand}"
                                   CommandParameter="https://github.com/keirf/greaseweazle" Margin="0,0,8,0" />
                        <ui:Button Appearance="Transparent" Content="Greaseweazle wiki" Command="{Binding OpenLinkCommand}"
                                   CommandParameter="https://github.com/keirf/greaseweazle/wiki" />
                    </WrapPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
