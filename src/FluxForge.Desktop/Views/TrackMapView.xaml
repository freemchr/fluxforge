<UserControl x:Class="FluxForge.Desktop.Views.TrackMapView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:FluxForge.Desktop.ViewModels"
             xmlns:v="clr-namespace:FluxForge.Desktop.Views"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:TrackMapViewModel}">
    <StackPanel>
        <!-- Sides wrap below each other on narrow windows instead of scrolling (a scrollbar hid the last row). -->
            <ItemsControl ItemsSource="{Binding Sides}" Focusable="False">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:TrackSideViewModel}">
                        <StackPanel Margin="0,0,28,10">
                            <TextBlock Text="{Binding Title}" Style="{StaticResource FfLabel}" Margin="24,0,0,6" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="24" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ItemsControl ItemsSource="{Binding RowLabels}" Focusable="False">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" Height="18" FontSize="9" Padding="0,3,5,0" TextAlignment="Right"
                                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <ItemsControl Grid.Column="1" ItemsSource="{Binding Cells}" Focusable="False"
                                              KeyboardNavigation.DirectionalNavigation="Cycle">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><UniformGrid Columns="10" /></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:TrackCellViewModel}">
                                            <Grid>
                                                <Button Style="{StaticResource FfTrackCell}" Content="{Binding Glyph}" Background="{Binding Brush}"
                                                        Command="{Binding SelectCommand}" ToolTip="{Binding ToolTip}"
                                                        AutomationProperties.Name="{Binding AccessibleName}" />
                                                <!-- Pulsing ring on the track the drive is working on right now -->
                                                <Border IsHitTestVisible="False" Margin="-1" CornerRadius="4" BorderThickness="2"
                                                        BorderBrush="{DynamicResource TextFillColorPrimaryBrush}" Opacity="0">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                                    <DataTrigger.EnterActions>
                                                                        <BeginStoryboard x:Name="Pulse">
                                                                            <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                                                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.15" To="1" Duration="0:0:0.4" />
                                                                            </Storyboard>
                                                                        </BeginStoryboard>
                                                                    </DataTrigger.EnterActions>
                                                                    <DataTrigger.ExitActions>
                                                                        <StopStoryboard BeginStoryboardName="Pulse" />
                                                                    </DataTrigger.ExitActions>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                </Border>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

        <ItemsControl ItemsSource="{Binding Legend}" Margin="24,10,0,0" Focusable="False">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal" Margin="0,0,14,4">
                        <Border Width="14" Height="14" CornerRadius="3" Background="{Binding Brush}" Margin="0,0,5,0">
                            <TextBlock Text="{Binding Glyph}" FontSize="9" FontWeight="Bold" Foreground="#E6000000"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="{Binding Label}" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Border Margin="24,10,0,0" Padding="10" CornerRadius="6" Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                Visibility="{Binding Selected, Converter={StaticResource VisibleWhen}}">
            <StackPanel>
                <TextBlock Text="{Binding Selected.ToolTip}" Style="{StaticResource FfBody}" FontSize="12" />
                <ItemsControl ItemsSource="{Binding Selected.Observation.LogLines}" Margin="0,6,0,0" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" FontFamily="{StaticResource FfMonoFont}" FontSize="11" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
