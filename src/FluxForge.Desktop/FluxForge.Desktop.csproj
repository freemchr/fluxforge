<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>FluxForge</AssemblyName>
    <RootNamespace>FluxForge.Desktop</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\fluxforge.ico</ApplicationIcon>
    <!-- Custom Main (Program.cs) so Velopack runs before WPF starts. -->
    <StartupObject>FluxForge.Desktop.Program</StartupObject>
    <EnableDefaultApplicationDefinition>false</EnableDefaultApplicationDefinition>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.13" />
    <PackageReference Include="Velopack" Version="1.2.161" />
    <PackageReference Include="WPF-UI" Version="4.3.0" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\fluxforge.ico" />
    <Resource Include="Assets\fluxforge-icon.png" />
    <Resource Include="Assets\fluxforge-wordmark.png" />
    <Resource Include="Assets\fluxforge-logo.png" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="System.IO" />
    <Using Include="System.Net.Http" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FluxForge.Application\FluxForge.Application.csproj" />
    <ProjectReference Include="..\FluxForge.Infrastructure\FluxForge.Infrastructure.csproj" />
  </ItemGroup>

</Project>
