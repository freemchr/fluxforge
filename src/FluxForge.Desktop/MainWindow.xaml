<ui:FluentWindow x:Class="FluxForge.Desktop.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:vm="clr-namespace:FluxForge.Desktop.ViewModels"
                 xmlns:v="clr-namespace:FluxForge.Desktop.Views"
                 mc:Ignorable="d"
                 d:DataContext="{d:DesignInstance vm:ShellViewModel}"
                 Title="FluxForge"
                 Icon="pack://application:,,,/Assets/fluxforge.ico"
                 Width="1180" Height="740" MinWidth="900" MinHeight="580" FontSize="13"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round">

    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:HomeViewModel}"><v:HomeView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:ReadDiskViewModel}"><v:ReadDiskView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:WriteDiskViewModel}"><v:WriteDiskView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:ImageStudioViewModel}"><v:ImageStudioView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:DriveToolsViewModel}"><v:DriveToolsView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:ActivityViewModel}"><v:ActivityView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}"><v:SettingsView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:PlaceholderViewModel}"><v:PlaceholderView /></DataTemplate>
    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Modifiers="Ctrl" Key="D1" Command="{Binding NavigateIndexCommand}" CommandParameter="1" />
        <KeyBinding Modifiers="Ctrl" Key="D2" Command="{Binding NavigateIndexCommand}" CommandParameter="2" />
        <KeyBinding Modifiers="Ctrl" Key="D3" Command="{Binding NavigateIndexCommand}" CommandParameter="3" />
        <KeyBinding Modifiers="Ctrl" Key="D4" Command="{Binding NavigateIndexCommand}" CommandParameter="4" />
        <KeyBinding Modifiers="Ctrl" Key="D5" Command="{Binding NavigateIndexCommand}" CommandParameter="5" />
        <KeyBinding Modifiers="Ctrl" Key="D6" Command="{Binding NavigateIndexCommand}" CommandParameter="6" />
        <KeyBinding Modifiers="Ctrl" Key="D7" Command="{Binding NavigateIndexCommand}" CommandParameter="7" />
        <KeyBinding Modifiers="Ctrl" Key="D8" Command="{Binding NavigateIndexCommand}" CommandParameter="8" />
        <KeyBinding Modifiers="Ctrl" Key="D9" Command="{Binding NavigateIndexCommand}" CommandParameter="9" />
    </Window.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="FluxForge">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/Assets/fluxforge.ico" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="196" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <DockPanel Grid.Column="0" Margin="8,8,4,8">
                <!-- Brand block, centred across the full sidebar width (the panel's outer margin is asymmetric). -->
                <StackPanel DockPanel.Dock="Top" Margin="-8,2,-4,14" HorizontalAlignment="Stretch" AutomationProperties.Name="FluxForge">
                    <!-- Optical centring: the round disc reads as the icon's centre, but the floppy and pixel trail
                         extend to the right of it, so nudge the artwork right to look centred. -->
                    <Image Source="{StaticResource FfIcon}" Width="102" Height="102" HorizontalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality">
                        <Image.RenderTransform><TranslateTransform X="9" /></Image.RenderTransform>
                    </Image>
                    <Image Source="{StaticResource FfWordmark}" Width="168" Margin="0,4,0,0" HorizontalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" />
                </StackPanel>
                <StackPanel DockPanel.Dock="Bottom" Margin="4,8,4,4">
                    <ui:Button Appearance="Transparent" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                               Icon="{ui:SymbolIcon ChatHelp24}" Content="Help &amp; issues"
                               Command="{Binding OpenSupportCommand}" ToolTip="{Binding SupportUrl}" />
                    <TextBlock Margin="8,6,8,0" FontSize="11" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                               Text="Independent frontend for the official Greaseweazle host tools." />
                </StackPanel>
                <ListBox ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}"
                         ItemContainerStyle="{StaticResource FfNavItem}"
                         Background="Transparent" BorderThickness="0"
                         AutomationProperties.Name="Main navigation">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:NavItem}">
                            <Grid AutomationProperties.Name="{Binding Title}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ui:SymbolIcon Symbol="{Binding Icon}" FontSize="16" Margin="0,0,10,0" />
                                <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="13" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                <TextBlock Grid.Column="2" Text="{Binding Shortcut}" FontSize="10" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>

            <Border Grid.Column="1" CornerRadius="8,0,0,0" BorderThickness="1,1,0,0"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    Background="{DynamicResource ApplicationBackgroundBrush}">
                <ContentControl Content="{Binding CurrentPage}" Focusable="False" />
            </Border>
        </Grid>

        <!-- Status bar: device, firmware and host tools are always shown as separate facts (PRD §6). -->
        <Border Grid.Row="2" Padding="8,2" BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
            <DockPanel LastChildFill="False">
                <Button DockPanel.Dock="Left" Style="{StaticResource FfStatusItem}" Command="{Binding DetectDeviceCommand}"
                        ToolTip="{Binding State.Device.Message}" AutomationProperties.Name="{Binding State.DeviceSummary, StringFormat='Device: {0}. Click to detect again.'}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="●" Margin="0,0,6,0" VerticalAlignment="Center"
                                   Foreground="{Binding State.Device.State, Converter={StaticResource Status}, ConverterParameter=brush}" />
                        <TextBlock Text="{Binding State.DeviceSummary}" />
                        <TextBlock Margin="6,0,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Text="{Binding State.Device.Info.Firmware, StringFormat='· firmware {0}'}"
                                   Visibility="{Binding State.Device.Info.Firmware, Converter={StaticResource VisibleWhen}}" />
                    </StackPanel>
                </Button>
                <Border DockPanel.Dock="Left" Width="1" Margin="4,5" Background="{DynamicResource CardStrokeColorDefaultBrush}" />
                <Button DockPanel.Dock="Left" Style="{StaticResource FfStatusItem}" Command="{Binding NavigateCommand}" CommandParameter="settings"
                        ToolTip="{Binding State.ToolsStatus.Message}" AutomationProperties.Name="{Binding State.ToolsSummary, StringFormat='Host tools: {0}. Click for settings.'}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Margin="0,0,6,0" FontWeight="Bold"
                                   Text="{Binding State.ToolsStatus.State, Converter={StaticResource Status}, ConverterParameter=glyph}"
                                   Foreground="{Binding State.ToolsStatus.State, Converter={StaticResource Status}, ConverterParameter=brush}" />
                        <TextBlock Text="{Binding State.ToolsSummary, StringFormat='Host tools {0}'}" />
                    </StackPanel>
                </Button>
                <Button DockPanel.Dock="Left" Style="{StaticResource FfStatusItem}" Command="{Binding NavigateCommand}" CommandParameter="settings"
                        Visibility="{Binding State.UpdateAvailable, Converter={StaticResource VisibleWhen}}">
                    <TextBlock Foreground="{StaticResource FfInfoBrush}" Text="{Binding State.LatestRelease.Version, StringFormat='↑ {0} available'}" />
                </Button>
                <Border DockPanel.Dock="Left" Margin="8,3,0,3" Padding="8,0" CornerRadius="8" BorderThickness="1"
                        BorderBrush="{StaticResource FfSimulatedBrush}"
                        Visibility="{Binding State.IsSimulated, Converter={StaticResource VisibleWhen}}"
                        ToolTip="FluxForge is talking to the development fake gw. No real disk is being read or written.">
                    <TextBlock Text="SIMULATED HARDWARE" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{StaticResource FfSimulatedBrush}" />
                </Border>

                <TextBlock DockPanel.Dock="Right" Margin="8,0" VerticalAlignment="Center" FontSize="12"
                           AutomationProperties.LiveSetting="Polite" Text="{Binding ActivityText}"
                           Foreground="{Binding ActivityBrush}" />
            </DockPanel>
        </Border>
    </Grid>
</ui:FluentWindow>
